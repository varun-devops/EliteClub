# ════════════════════════════════════════════════════════════════════
#  Nginx site config for Elite Club on a Hostinger VPS.
#
#  INSTALL:
#    sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/elite-club
#    sudo nano /etc/nginx/sites-available/elite-club   # replace YOUR-DOMAIN
#    sudo ln -sf /etc/nginx/sites-available/elite-club /etc/nginx/sites-enabled/
#    sudo rm -f /etc/nginx/sites-enabled/default
#    sudo nginx -t && sudo systemctl reload nginx
#
#  Then get free SSL (this rewrites the file to add the 443 block for you):
#    sudo certbot --nginx -d YOUR-DOMAIN.com -d www.YOUR-DOMAIN.com
# ════════════════════════════════════════════════════════════════════

server {
    listen 80;
    listen [::]:80;
    server_name YOUR-DOMAIN.com www.YOUR-DOMAIN.com;

    # Uploads go straight to Cloudinary from the browser, so requests through
    # Nginx stay small. This is headroom for form posts.
    client_max_body_size 12M;

    # Let Next.js do its own compression (next.config.ts sets compress: true).
    gzip off;

    # ── Next.js build assets: immutable, cache them hard ──────────────
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_cache_valid 200 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # ── Everything else → the Next.js server ──────────────────────────
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        # Preserve the real client details. Without X-Forwarded-Proto the app
        # thinks every request is plain HTTP and the admin's Secure cookie
        # will not be set.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 60s;
        proxy_buffering    off;
    }

    # ── Razorpay webhook ──────────────────────────────────────────────
    # Razorpay signs the RAW request body. Any rewriting or buffering here
    # would break the signature check, so this location stays untouched.
    location = /api/payment/webhook {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_buffering         off;
    }
}
